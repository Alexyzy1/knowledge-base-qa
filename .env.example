# ============================================================
# 知识库问答系统 — 环境变量配置
# 复制此文件为 .env 并填入你的配置
#   cp .env.example .env
# ============================================================

# ── 必填 ──────────────────────────────────────────────
# LLM API Key（DeepSeek / Qwen / OpenAI 兼容）
MODEL_API_KEY=sk-your-api-key-here

# JWT 签名密钥（生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"）
JWT_SECRET=your-random-jwt-secret-here

# 管理员初始密码（首次启动时自动创建 admin 账号）
ADMIN_PASSWORD=your-admin-password

# ── 模型配置（选填，默认用 DeepSeek）──────────────────
# MODEL_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=your-embedding-api-key   # 不设置则复用 MODEL_API_KEY
# EMBEDDING_DIM=1536   # text-embedding-3-small 维度

# ── 数据库（Docker Compose 默认值，源码安装需修改）────
# MYSQL_URL=mysql+pymysql://kb_user:kb_pass@mysql:3306/knowledge_base?charset=utf8mb4
# MILVUS_HOST=milvus-standalone
# MILVUS_PORT=19530

# ── ASR（语音转文字，选填）─────────────────────────────
# ASR_ENGINE=qwen   # "legacy" 或 "qwen"
# QWEN_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_ASR_API_KEY=your-qwen-api-key
# QWEN_ASR_MODEL=Qwen3-ASR-1.7B

# ── IP 白名单（选填）───────────────────────────────────
# IP_ACCESS_ENABLED=false   # 设为 true 开启
# IP_ACCESS_ALLOWED=127.0.0.1,192.168.,10.,172.17.

# ── MySQL 数据库密码（Docker Compose 用）───────────────
# MYSQL_ROOT_PASSWORD=change-me-in-production
